{
  "schema": "proofline/1",
  "project": "hivevault",
  "owner_rules": [
    "Done means ALL evidence: implemented as specified (task id), a test that FAILED before and passes now, suites green, measured number vs target, docs regenerated, committed AND pushed to main.",
    "Never defer: no \"later\", \"follow-up\", \"out of scope\". If blocked: what blocks, what you tried, what you need; then continue with the next task.",
    "Root cause, then fix: file:line + mechanism. No weakening tests, raising timeouts, skips, relaxed assertions.",
    "No silent scope cuts: never lower targets, caps or test sizes without owner approval.",
    "Never bypass guards: no --no-verify, no bypass env vars, no skip flags.",
    "Deliver continuously: one task per commit, pushed to main as it goes green.",
    "Honest reporting: TASK-ID | status | commit | tests | measured vs target | missing."
  ],
  "defaults": {
    "base": "origin/main",
    "branch": "main",
    "flaky_reruns": 1,
    "max_corrective_cycles": 3,
    "regression_tolerance_pct": 20
  },
  "forbidden": {
    "test_skip_only": true,
    "timeout_raise": true,
    "assertion_removal": true,
    "test_file_deletion": true,
    "no_verify": true,
    "bypass_env": [
      "HIVEVAULT_ALLOW_PUBLIC_PUSH",
      "SKIP_HOOKS",
      "HUSKY=0",
      "PROOFLINE_SKIP",
      "CI_SKIP"
    ],
    "protected_values": [
      {
        "file": "bench/e2e.mjs",
        "pattern": "Wn===1\\?(\\d+)",
        "why": "single-writer sample count must not shrink"
      },
      {
        "file": "bench/e2e.mjs",
        "pattern": "Math\\.ceil\\((\\d+)/Wn\\)",
        "why": "concurrent sample count must not shrink"
      }
    ]
  },
  "baseline": {
    "metrics": {
      "4k.flushMs": 14400,
      "4k.writers1.p50": 128,
      "4k.writers32.savesPerSec": 9,
      "10k.flushMs": 45000,
      "10k.writers1.p50": 204,
      "10k.writers32.savesPerSec": 5
    }
  },
  "phases": [
    {
      "id": "intake"
    },
    {
      "id": "design"
    },
    {
      "id": "plan"
    },
    {
      "id": "implement"
    },
    {
      "id": "verify"
    },
    {
      "id": "integrate"
    },
    {
      "id": "release"
    },
    {
      "id": "monitor"
    }
  ],
  "tasks": [
    {
      "id": "FP-00",
      "title": "Bench rig committed in the repo",
      "phase": "plan",
      "depends_on": [],
      "requirements": [],
      "description": "Copy the bench kit into bench/ and commit it, so every metric gate can be reproduced from a clean checkout (lesson: the rig lived only on one machine).",
      "scope": {
        "allow": [
          "bench/**",
          "CHANGELOG.md",
          "docs/MAP.md"
        ]
      },
      "criteria": [
        {
          "id": "FP-00-AC01",
          "mandatory": true,
          "statement": "bench/e2e.mjs committed",
          "verifier": {
            "type": "file_exists",
            "path": "bench/e2e.mjs"
          }
        },
        {
          "id": "FP-00-AC02",
          "mandatory": true,
          "statement": "bench/lib.mjs committed",
          "verifier": {
            "type": "file_exists",
            "path": "bench/lib.mjs"
          }
        },
        {
          "id": "FP-00-AC03",
          "mandatory": true,
          "statement": "bench/hvtrace.mjs committed",
          "verifier": {
            "type": "file_exists",
            "path": "bench/hvtrace.mjs"
          }
        },
        {
          "id": "FP-00-AC04",
          "mandatory": true,
          "statement": "Committed and pushed",
          "verifier": {
            "type": "pushed"
          }
        }
      ],
      "stop_rules": [
        "If any metric misses its threshold: STOP, report the measured number, a per-stage trace and file:line. Do not start the next task."
      ]
    },
    {
      "id": "FP-01",
      "title": "Git commit without one process per file",
      "phase": "implement",
      "depends_on": [
        "FP-00"
      ],
      "requirements": [
        "#407"
      ],
      "description": "server/src/sync.mjs _fastImport: replace the per-file `git cat-file blob :path` loop with one `git ls-files -s -z` per batch; emit `M <mode> <blob-id> <path>`.",
      "scope": {
        "allow": [
          "server/src/**",
          "server/test/**",
          "docs/**",
          "bench/**",
          "CHANGELOG.md",
          "docs/MAP.md"
        ]
      },
      "criteria": [
        {
          "id": "FP-01-AC01",
          "mandatory": true,
          "statement": "200-file batch uses ≤ 3 _gitInput calls; git fsck exit 0; all 200 files correct",
          "verifier": {
            "type": "test_red_green",
            "test_file": "server/test/fastimport_spawns.test.mjs",
            "test_name": null,
            "cmd": "node --test {test}"
          }
        },
        {
          "id": "FP-01-AC02",
          "mandatory": true,
          "statement": "flushMs <= 1500 at 4k",
          "verifier": {
            "type": "metric",
            "cmd": "WAIT=durable HV_REPO=$PWD BENCH_DIR=/tmp/hvbench node bench/e2e.mjs 4000 47710",
            "key": "flushMs",
            "op": "<=",
            "value": 1500,
            "name": "4k.flushMs",
            "labels": [
              "seal",
              "flush"
            ],
            "timeout_s": 3600
          }
        },
        {
          "id": "FP-01-AC03",
